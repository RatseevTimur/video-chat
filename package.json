{
  "name": "react-video-chat",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "concurrently": "^8.2.2"
  },
  "scripts": {
    "dev": "concurrently \"yarn --cwd server dev\" \"yarn --cwd client dev\"",
    "build": "yarn --cwd client install --frozen-lockfile --production=false && yarn --cwd client build && yarn --cwd server install --frozen-lockfile",
    "postinstall": "node scripts/render-postinstall.cjs",
    "client:install": "cd client && yarn",
    "client:build": "cd client && yarn build",
    "server:install": "cd server && yarn",
    "start": "bash ./start.sh",
    "start:server": "cd server && node index.js",
    "mvp": "bash ./start.sh",
    "mvp:dev": "yarn dev"
  }
}
