{
  "appId": "com.videochat.app",
  "appName": "Video Chat",
  "webDir": "dist",
  "server": {
    "androidScheme": "http",
    "cleartext": true,
    "hostname": "localhost",
    "allowNavigation": [
      "192.168.0.29:4000"
    ]
  },
  "plugins": {
    "Camera": {
      "permissions": [
        "camera",
        "photos"
      ]
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "LocalNotifications": {
      "smallIcon": "ic_launcher",
      "iconColor": "#1a73e8"
    }
  }
}
