PORT=4000
# INVITE=my-family-secret
# PUBLIC_URL=https://xxxx.trycloudflare.com
# OPEN_ROOM=family-call   # optional fixed room id printed by start.sh

# Default = FREE MODE: / creates rooms, /room/:id — anyone with the link.
# Optional family messenger at /family (email OTP):

# A: без MAIL_URL → код в терминале (только /family)
#
# A+: OTP на почту, сообщения всё равно только в RAM
# MAIL_URL=smtps://login%40yandex.ru:app-password@smtp.yandex.ru:465
# MAIL_STORE=0
#
# B: OTP на почту + почта как «БД» (уведомления + шифротекст)
# MAIL_URL=smtps://login%40yandex.ru:app-password@smtp.yandex.ru:465
