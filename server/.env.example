PORT=4000
# INVITE=my-family-secret
# PUBLIC_URL=https://xxxx.trycloudflare.com
# OPEN_ROOM=family-call

# Free mode by default. Optional /family OTP:

# A: no MAIL_URL → code in terminal
#
# A+: email OTP, chat still RAM-only
# MAIL_URL='smtps://login%40gmail.com:APP_PASSWORD@smtp.gmail.com:465'
# SMTP_FROM='login@gmail.com'
# MAIL_STORE=0
#
# Yandex:
# MAIL_URL='smtps://login%40yandex.ru:app-password@smtp.yandex.ru:465'
# MAIL_STORE=0
#
# B: OTP + mail as store
# MAIL_URL='smtps://login%40yandex.ru:app-password@smtp.yandex.ru:465'
